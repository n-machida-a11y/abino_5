Attribute VB_Name = "Config"
Option Explicit

'================================================================================
' モジュール: Config（【共有_経理用】請求書作成.xlsm 用）
'================================================================================
' 【役割】
'   経理用ブック全体で使う「設定値」を一元管理するモジュール。
'   このファイルを修正するだけで、テスト/本番切替やシート名変更等に対応できる。
'
' 【依存関係】
'   呼び出し元: 保存.bas, シート更新.bas, 請求書作成.bas
'   - GetMasterPath()      → マスタファイルのフルパスを返す
'   - SHEET_IRAI_RIREKI    → "依頼履歴" のシート名定数
'   - SHEET_IRAI_SEARCH    → "依頼検索" のシート名定数
'
' 【設定変更の手引き】
'   ★ IS_TEST_MODE を本番時は False にすること（最重要）
'   ★ マスタファイルパスは「依頼履歴」シートのG1セルで指定する設計
'     コード側のパスは TEST_MASTER_FILE_PATH のみ（テスト用）
'
' 【変更履歴】
'   - 2026/4: 初版作成、Application.Run経由→直接呼び出しに変更
'   - 2026/5: 経理番号採番のロジック整理
'================================================================================


'================================================================================
' ★★★ テストモード切替（最重要）★★★
'================================================================================
'   True  : machida のデスクトップにあるテスト用マスタを参照
'   False : 「依頼履歴」シートG1セルに記入されたパスを参照（本番運用）
'
'   ★ お客様環境にデプロイ時は必ず False にすること ★
'================================================================================
Public Const IS_TEST_MODE As Boolean = False

' テスト用マスタファイルのパス（IS_TEST_MODE=True の時のみ参照される）
Public Const TEST_MASTER_FILE_PATH As String = "Z:\Users\n-machida\Desktop\工事番号管理表.xlsm"


'================================================================================
' シート名定数
'================================================================================
'   外部マスタ（工事番号管理表.xlsm）と同じ名前である必要がある
'   依頼NOで検索する時、マスタの「依頼履歴」シートを参照する
Public Const SHEET_IRAI_RIREKI As String = "依頼履歴"     ' マスタ側の履歴シート
Public Const SHEET_IRAI_SEARCH As String = "依頼検索"     ' 経理用ブック内の検索シート


'================================================================================
' マスタファイルパス記載セル（依頼検索シート上）
'================================================================================
'   依頼履歴シートのG1セルに、マスタファイルのフルパスを入れる運用
'   お客様環境で変更があった時、VBAは触らずG1セルだけ書き換えればOK
Private Const MASTER_PATH_CELL_KEIRI As String = "G1"


'================================================================================
' GetMasterPath: マスタファイルのフルパスを返す共通関数
'================================================================================
' 【使用箇所】
'   保存.bas:SyncInvoiceNoToMaster      （保存時にマスタへ経理No書き込み）
'   シート更新.bas:マクロ_検索実行       （依頼NOでマスタを検索）
'   シート更新.bas:SyncAllDataToMaster   （新規・上書き保存時の同期）
'
' 【動作】
'   IS_TEST_MODE = True  → TEST_MASTER_FILE_PATH を返す
'   IS_TEST_MODE = False → 「依頼履歴」シートのG1セル値を返す
'                          （末尾のダブルクォートはこの関数では除去しない。
'                            呼び出し側で処理する設計）
'================================================================================
Public Function GetMasterPath() As String
    If IS_TEST_MODE Then
        GetMasterPath = TEST_MASTER_FILE_PATH
    Else
        GetMasterPath = Trim(CStr(ThisWorkbook.Sheets(SHEET_IRAI_RIREKI).Range(MASTER_PATH_CELL_KEIRI).Value))
    End If
End Function


'================================================================================
' シート保護関連（マスタへの書き込み時に使用）
'================================================================================
' 【追加 2026/5/20】お客様環境ではマスタの依頼履歴シートが保護されており、
' マクロ_上書き保存 / マクロ_新規作成 / 保存 等でマスタへ書き込む際に
' 「実行時エラー 1004: 変更しようとしているセルは保護されているシート上にあります」
' が発生したため、保護解除→書き込み→再保護のヘルパーを追加。
'
' パスワード「3555」は他のVBA(現場用・管理者用)と統一されている。
'================================================================================
Public Const SHEET_PASSWORD As String = "3555"

'--- 保護解除（複数パスワードを試して確実に解除）---
'   1. SHEET_PASSWORD (3555) で試す
'   2. パスワード無しで試す（パスワード設定無しの保護に対応）
'   3. それでも保護されたままなら、書込時にエラーになる
'      （その時はユーザーに保護解除を依頼するしかない）
Public Sub SafeUnprotect(ByVal ws As Worksheet)
    If ws Is Nothing Then Exit Sub

    On Error Resume Next
    ' (1) 既定パスワードで試す
    ws.Unprotect Password:=SHEET_PASSWORD
    Err.Clear

    ' (2) まだ保護されていればパスワード無しで試す
    If ws.ProtectContents Then
        ws.Unprotect
        Err.Clear
    End If

    On Error GoTo 0
End Sub

'--- 再保護（フィルタ・ソートは許可する）---
Public Sub SafeProtect(ByVal ws As Worksheet)
    If ws Is Nothing Then Exit Sub
    On Error Resume Next
    ws.Protect Password:=SHEET_PASSWORD, _
               AllowFiltering:=True, _
               AllowSorting:=True, _
               UserInterfaceOnly:=False
    On Error GoTo 0
End Sub
